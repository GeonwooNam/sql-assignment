# 이 파일을 secrets.toml 로 복사한 뒤 값을 채우세요.
# secrets.toml 은 절대 깃에 올리지 마세요. (.gitignore 에 이미 들어 있습니다)
# 이 .example 파일은 깃에 추적되므로 여기에는 실제 키를 절대 넣지 마세요.

OPENAI_API_KEY = "sk-여기에-발급받은-키"

# 접속 코드. 학회 공지에 함께 올려서 학회원만 쓰게 합니다.
# 비워두면 문지기 없이 누구나 접속할 수 있습니다.
# 이 리포는 공개되어 있으므로, 아래 예시 값을 그대로 쓰지 말고 직접 정하세요.
ACCESS_CODE = "여기에-직접-정한-코드"

# ── 아래 둘은 선택 사항 ──────────────────────────────────────

# 발제자 코드. 설정하면 사이드바에 입력칸이 생기고, 맞게 넣으면 제출 로그를 볼 수 있습니다.
# 비워두면 로그 패널 자체가 뜨지 않습니다. ACCESS_CODE 와 다른 값으로 정하세요.
ADMIN_CODE = "발제자만-아는-코드"

# 제출 기록을 받을 웹훅 URL (Google Sheets 등). 설정하면 제출마다 JSON 한 건을 POST 합니다.
# Streamlit Cloud 는 앱이 잠들거나 재배포될 때 파일이 초기화되므로,
# 제출물을 영구 보존하려면 이게 필요합니다. 만드는 방법은 README 참고.
# LOG_WEBHOOK_URL = "https://script.google.com/macros/s/..../exec"
